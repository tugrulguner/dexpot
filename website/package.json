{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "test:playground": "node --test tests/*.test.js",
    "test:visual": "playwright test",
    "check": "astro check",
    "build": "node scripts/sync-project-docs.mjs && astro build && npm run copy:guides && npm run verify:rendered",
    "copy:guides": "node scripts/copy-guides.mjs",
    "verify:rendered": "node scripts/verify-rendered-output.mjs && node scripts/verify-guides.mjs",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.4",
    "astro": "^7.2.10",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.149.0"
  }
}
