---
import capture from '../content/docs/data/typed-crud-capture.json';
---

<label class="crud-capture__label" for="crud-step">Recorded request
  <select id="crud-step" aria-controls="crud-result">
  {capture.steps.map((step, index) => (
    <option value={index}>{step.method} {step.path} → {step.status}</option>
  ))}
  </select>
</label>
<pre id="crud-result" aria-live="polite"></pre>
<small id="crud-provenance"></small>

<script>
  import capture from '../content/docs/data/typed-crud-capture.json';

  const selector = document.querySelector<HTMLSelectElement>('#crud-step');
  const result = document.querySelector<HTMLElement>('#crud-result');
  const provenance = document.querySelector<HTMLElement>('#crud-provenance');
  if (selector && result && provenance) {
    const activeSelector = selector;
    const activeResult = result;
    const activeProvenance = provenance;

    function render() {
      const step = capture.steps[Number(activeSelector.value)];
      activeResult.textContent = JSON.stringify(
        {
          request: { method: step.method, path: step.path, body: step.request },
          response: { status: step.status, body: step.response },
        },
        null,
        2,
      );
    }

    activeSelector.addEventListener('change', render);
    render();
    activeProvenance.textContent = `Recorded execution · ${capture.source.file} · commit ${capture.source.commit} · SHA-256 ${capture.source.sha256} · Dexpot ${capture.source.version}`;
  }
</script>

<style>
  .crud-capture__label {
    display: grid;
    gap: 0.5rem;
    max-width: 24rem;
  }

  .crud-capture__label select {
    box-sizing: border-box;
    max-width: 100%;
    min-width: 0;
    width: 100%;
  }

  #crud-provenance {
    display: block;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  #crud-result {
    max-width: 100%;
    overflow-x: auto;
  }
</style>
