---
import dexpotMark from '../assets/dexpot-mark.svg';
---
<section aria-label="Browser-local CRUD request workbench" class="crud-playground">
  <header class="workbench-heading">
    <div><p class="eyebrow">BROWSER-LOCAL CONTRACT <span>NO SERVER REQUESTS</span></p>
    <p class="workbench-intro">Use the actual typed CRUD example as a guide, then run a bounded request locally.</p></div>
    <img src={dexpotMark.src} alt="" width="42" height="42" /></header>
  <div class="workbench-layout">
    <div class="code-pane"><div class="pane-label"><span>examples/typed_crud.py · create_item</span><span>PYTHON · SYNC</span></div><pre><code>@app.post("/items", body=ItemIn, response=Item)
def create_item(item: ItemIn) -> tuple[int, Item]:
    global _next_id
    with _lock:
        created = Item(id=_next_id, name=item.name, price=item.price)
        _items[_next_id] = created
        _next_id += 1
    return 201, created</code></pre><a href="https://github.com/tugrulguner/dexpot/blob/main/examples/typed_crud.py">Open complete example ↗</a></div>
    <div class="request-pane"><div class="pane-label"><span>REQUEST BUILDER</span><span id="request-target">POST /items</span></div>
      <label>Operation <select id="operation"><option value="create">POST · create</option><option value="update">PUT · update</option><option value="get">GET · read</option><option value="delete">DELETE · remove</option></select></label>
      <label>Item ID <input id="item-id" type="number" value="1"></label><label>Name <input id="item-name" value="Notebook"></label><label>Price <input id="item-price" type="number" step="any" value="12.5"></label>
      <div class="workbench-actions"><button type="button" id="contract-run">▶ &nbsp; Run locally</button><button type="button" id="contract-reset">Reset</button></div>
    </div>
  </div>
  <p id="contract-error" role="alert"></p>
  <div class="result-pane"><div class="pane-label"><span>RESPONSE TRACE</span><span>IN-MEMORY · THIS TAB ONLY</span></div><div class="contract-grid"><article><h3>Request</h3><pre id="contract-request">Awaiting run()</pre></article><article><h3>Computed response</h3><pre id="contract-response" aria-live="polite">No response yet.</pre></article></div></div>
  <p class="contract-note">Local contract preview—not a Python server. No network calls. Starts with the example item; maximum 20 live items. Editing is inert until Run.</p>
</section>
<script>
  import { createState, execute } from '../scripts/crud-playground.js';
  const state = createState();
  const operation = document.querySelector<HTMLSelectElement>('#operation');
  const idField = document.querySelector<HTMLInputElement>('#item-id');
  const nameField = document.querySelector<HTMLInputElement>('#item-name');
  const priceField = document.querySelector<HTMLInputElement>('#item-price');
  const text = (selector: string, value: string) => { const node = document.querySelector<HTMLElement>(selector); if (node) node.textContent = value; };
  const refreshTarget = () => {
    if (!operation || !idField) return;
    const methods: Record<string, string> = { create: 'POST', update: 'PUT', get: 'GET', delete: 'DELETE' };
    const path = operation.value === 'create' ? '/items' : `/items/${idField.value}`;
    text('#request-target', `${methods[operation.value]} ${path}`);
  };
  operation?.addEventListener('change', refreshTarget);
  idField?.addEventListener('input', refreshTarget);
  document.querySelector<HTMLButtonElement>('#contract-run')?.addEventListener('click', () => {
    if (!operation || !idField || !nameField || !priceField) return;
    const rawPrice = priceField.value;
    const result = execute(state, { operation: operation.value, id: Number(idField.value), name: nameField.value, price: rawPrice === '' ? Number.NaN : Number(rawPrice) });
    Object.assign(state, result.state);
    text('#contract-request', JSON.stringify(result.result.request, null, 2));
    text('#contract-response', JSON.stringify(result.result.response, null, 2));
    text('#contract-error', result.result.response.status >= 400 ? result.result.response.body.detail : '');
  });
  document.querySelector<HTMLButtonElement>('#contract-reset')?.addEventListener('click', () => {
    Object.assign(state, createState());
    if(operation) operation.value='create'; if(idField) idField.value='1'; if(nameField) nameField.value='Notebook'; if(priceField) priceField.value='12.5';
    refreshTarget();
    text('#contract-request', 'Awaiting run()'); text('#contract-response', 'No response yet.'); text('#contract-error', '');
  });
</script>
<style>
  .crud-playground { margin-block:1rem .75rem; padding:clamp(.75rem,2vw,1.25rem); border:1px solid var(--sl-color-gray-5); background:color-mix(in srgb,var(--sl-color-gray-6) 45%,transparent); }
  .workbench-heading { display:flex; justify-content:space-between; gap:1rem; align-items:center; }
  .workbench-heading img { flex:none; }
  .eyebrow { margin:0; color:var(--sl-color-accent); font:600 .72rem var(--sl-font-mono); letter-spacing:.06em; }
  .eyebrow span { margin-left:.6rem; color:var(--sl-color-gray-2); }
  .workbench-intro { margin:.4rem 0 0; color:var(--sl-color-gray-2); font-size:.92rem; }
  .workbench-layout { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(15rem,.85fr); gap:clamp(.75rem,2vw,1.25rem); margin-top:1rem; }
  .code-pane,.request-pane { min-width:0; }
  .pane-label { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.4rem; color:var(--sl-color-gray-2); font: .7rem var(--sl-font-mono); letter-spacing:.04em; }
  .code-pane pre { margin:.65rem 0; padding:.7rem; color:var(--sl-color-white); background:var(--sl-color-black); font-size:.84rem; line-height:1.55; white-space:pre; overflow:auto; }
  .code-pane a { font: .76rem var(--sl-font-mono); }
  .request-pane label { display:grid; gap:.3rem; margin-top:.55rem; color:var(--sl-color-gray-1); font-size:.84rem; }
  .request-pane :is(input,select) { box-sizing:border-box; width:100%; min-width:0; padding:.5rem; border:1px solid var(--sl-color-gray-4); border-radius:0; color:var(--sl-color-white); background:var(--sl-color-black); font:inherit; }
  .workbench-actions { display:flex; flex-wrap:wrap; gap:.5rem; margin-top:.8rem; }
  .workbench-actions button { min-height:2.5rem; padding:.55rem .75rem; border:1px solid var(--sl-color-accent); border-radius:0; color:#06111a; background:var(--sl-color-accent); font: .75rem var(--sl-font-mono); cursor:pointer; }
  .workbench-actions button + button { color:var(--sl-color-white); background:transparent; border-color:var(--sl-color-gray-4); }
  :global(:root[data-theme='light']) .workbench-actions button:first-child { color:#fff; background:#003b50; border-color:#003b50; }
  .result-pane { margin-top:.85rem; padding-top:.7rem; border-top:1px solid var(--sl-color-gray-5); }
  .contract-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.75rem; margin-top:.5rem; }
  .contract-grid article { min-width:0; }
  .contract-grid h3 { margin:.2rem 0; color:var(--sl-color-gray-2); font: .7rem var(--sl-font-mono); text-transform:uppercase; }
  .contract-grid pre { max-width:100%; margin:.35rem 0; padding:.55rem; overflow:auto; color:var(--sl-color-white); background:var(--sl-color-black); white-space:pre-wrap; overflow-wrap:anywhere; font-size:.76rem; }
  #contract-error { color:var(--sl-color-red); }
  .contract-note { margin: .55rem 0 0; color:var(--sl-color-gray-2); font-size:.76rem; }
  @media (max-width:42rem) { .workbench-layout,.contract-grid { grid-template-columns:minmax(0,1fr); } .workbench-heading img { width:32px; height:32px; } }
</style>
