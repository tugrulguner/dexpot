---
import dexpotMark from '../assets/dexpot-mark.svg';
---
<section aria-label="Browser-local CRUD request workbench" class="crud-playground">
  <header class="workbench-heading">
    <div><p class="eyebrow">BROWSER-LOCAL CONTRACT <span>NO SERVER REQUESTS</span></p>
    <p class="workbench-intro">Use the actual typed CRUD example as a guide, then run a bounded request locally.</p></div>
    <img src={dexpotMark.src} alt="" width="42" height="42" /></header>
  <div class="workbench-layout">
    <div class="code-pane"><div class="pane-label"><span>examples/typed_crud.py · create_item</span><span>PYTHON · SYNC</span></div><pre><code>@app.post("/items", body=ItemIn, response=Item)
def create_item(item: ItemIn) -> tuple[int, Item]:
    global _next_id
    with _lock:
        created = Item(id=_next_id, name=item.name, price=item.price)
        _items[_next_id] = created
        _next_id += 1
    return 201, created</code></pre><a href="https://github.com/tugrulguner/dexpot/blob/main/examples/typed_crud.py">Open complete example ↗</a></div>
    <div class="workbench-right">
      <div class="request-pane"><div class="pane-label"><span>REQUEST BUILDER</span><span id="request-target">POST /items</span></div>
        <label>Operation <select id="operation"><option value="create">POST · create</option><option value="update">PUT · update</option><option value="get">GET · read</option><option value="delete">DELETE · remove</option></select></label>
        <label>Item ID <input id="item-id" type="number" value="1"></label><label>Name <input id="item-name" value="Notebook"></label><label>Price <input id="item-price" type="number" step="any" value="12.5"></label>
        <div class="workbench-actions"><button type="button" id="contract-run">Run locally</button><button type="button" id="contract-reset">Reset</button></div>
        <p id="run-timing" class="run-timing" aria-live="polite">— <span>Browser-local processing only. Excludes Dexpot Python/server and network latency.</span></p>
        <p class="contract-note">Local contract preview, not a Python server. No network calls. Starts with the example item; maximum 20 live items. Editing clears the last result. Only Run executes.</p>
      </div>
      <div class="result-pane"><div class="contract-grid"><article><h3>Request</h3><pre id="contract-request">Awaiting run()</pre></article><article><h3>Computed response</h3><pre id="contract-response" aria-live="polite">No response yet.</pre></article></div></div>
    </div>
  </div>
  <p id="contract-error" role="alert"></p>
</section>
<script>
import { createState, execute, measureRun } from '../scripts/crud-playground.js';
  const state = createState();
  const operation = document.querySelector<HTMLSelectElement>('#operation');
  const idField = document.querySelector<HTMLInputElement>('#item-id');
  const nameField = document.querySelector<HTMLInputElement>('#item-name');
  const priceField = document.querySelector<HTMLInputElement>('#item-price');
  const text = (selector: string, value: string) => { const node = document.querySelector<HTMLElement>(selector); if (node) node.textContent = value; };
  const clearOutput = () => {
    text('#contract-request', 'Awaiting run()'); text('#contract-response', 'No response yet.'); text('#contract-error', '');
    const timing = document.querySelector<HTMLElement>('#run-timing');
    if (timing) timing.firstChild!.textContent = '— ';
  };
  for (const field of [operation, idField, nameField, priceField]) {
    field?.addEventListener('input', clearOutput);
    field?.addEventListener('change', clearOutput);
  }
  const refreshTarget = () => {
    if (!operation || !idField) return;
    const methods: Record<string, string> = { create: 'POST', update: 'PUT', get: 'GET', delete: 'DELETE' };
    const path = operation.value === 'create' ? '/items' : `/items/${idField.value}`;
    text('#request-target', `${methods[operation.value]} ${path}`);
  };
  operation?.addEventListener('change', refreshTarget);
  idField?.addEventListener('input', refreshTarget);
  document.querySelector<HTMLButtonElement>('#contract-run')?.addEventListener('click', () => {
    if (!operation || !idField || !nameField || !priceField) return;
    const timing = document.querySelector<HTMLElement>('#run-timing');
    if (timing) timing.firstChild!.textContent = '— ';
    const rawPrice = priceField.value;
    const measured = measureRun(() => {
      const result = execute(state, { operation: operation.value, id: Number(idField.value), name: nameField.value, price: rawPrice === '' ? Number.NaN : Number(rawPrice) });
      Object.assign(state, result.state);
      text('#contract-request', JSON.stringify(result.result.request, null, 2));
      text('#contract-response', JSON.stringify(result.result.response, null, 2));
      text('#contract-error', result.result.response.status >= 400 ? result.result.response.body.detail : '');
    });
    if (timing) timing.firstChild!.textContent = `${measured.elapsedMs.toFixed(3)} ms `;
  });
  document.querySelector<HTMLButtonElement>('#contract-reset')?.addEventListener('click', () => {
    Object.assign(state, createState());
    if(operation) operation.value='create'; if(idField) idField.value='1'; if(nameField) nameField.value='Notebook'; if(priceField) priceField.value='12.5';
    refreshTarget();
    clearOutput();
  });
</script>
<style>
  .crud-playground { margin-block:1rem .75rem; padding:clamp(.75rem,2vw,1.25rem); border:1px solid var(--sl-color-gray-5); background:var(--play-surface); color:var(--play-ink); font-size:14px; }
  .crud-playground :global(*) { box-sizing:border-box; }
  .workbench-heading { display:flex; justify-content:space-between; gap:1rem; align-items:center; }
  .workbench-heading img { flex:none; }
  .eyebrow { margin:0; color:var(--play-muted); font-size:13px; }
  .eyebrow span { margin-left:.6rem; color:var(--play-muted); }
  .workbench-intro { margin:.4rem 0 0; color:var(--play-muted); font-size:14px; }
  .workbench-layout { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); align-items:start; gap:clamp(.75rem,2vw,1.25rem); margin-top:1rem; }
  .code-pane,.workbench-right { min-width:0; }
  .workbench-right { display:grid; gap:.9rem; }
  .pane-label { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.4rem; color:var(--play-muted); font-size:13px; }
  .code-pane pre,.contract-grid pre { box-sizing:border-box; max-width:100%; margin:.55rem 0; padding:.7rem; color:var(--play-ink); background:var(--play-code); font-size:12.5px; line-height:1.55; }
  .code-pane pre { overflow:auto; white-space:pre; }
  .code-pane a { font-size:13px; }
  .request-pane label { display:grid; gap:.3rem; margin:.55rem 0 0; color:var(--play-ink); font-size:13px; }
  .request-pane :is(input,select) { box-sizing:border-box; width:100%; min-width:0; min-height:2.35rem; padding:.45rem .55rem; border:1px solid var(--play-border); border-radius:6px; color:var(--play-ink); background:var(--play-code); font:inherit; }
  .request-pane :is(input,select):focus-visible,.workbench-actions button:focus-visible { outline:2px solid var(--play-accent); outline-offset:2px; }
  .workbench-actions { display:flex; flex-wrap:wrap; align-items:flex-start; gap:.5rem; margin-top:.8rem; }
  .workbench-actions button { box-sizing:border-box; display:inline-flex; align-items:center; justify-content:center; height:44px; min-height:44px; margin:0; padding:.6rem .8rem; border:1px solid var(--play-accent); border-radius:6px; color:var(--play-button-ink); background:var(--play-accent); font:600 14px/1 var(--sl-font); cursor:pointer; }
  .workbench-actions button + button { color:var(--play-ink); background:transparent; border-color:var(--play-border); }
  .result-pane { min-width:0; padding-top:.65rem; border-top:1px solid var(--play-border); }
  .contract-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); align-items:stretch; gap:.7rem; }
  .contract-grid article { min-width:0; display:flex; flex-direction:column; align-items:stretch; margin:0; }
  .contract-grid h3 { all:unset; display:block; flex:none; box-sizing:border-box; min-height:1.45em; margin:0 0 .35rem; padding:0; color:var(--play-muted); font:500 14px/1.45 var(--sl-font); }
  .contract-grid pre { flex:1; min-height:5.5rem; max-height:14rem; margin:0; overflow:auto; white-space:pre-wrap; overflow-wrap:anywhere; }
  #contract-error { min-height:0; margin:0; color:var(--play-error); font-size:13px; }
  .contract-note { margin:.65rem 0 0; color:var(--play-muted); font-size:13px; line-height:1.45; }
  .run-timing { display:flex; flex-wrap:wrap; align-items:baseline; gap:.55rem; margin:.65rem 0 0; color:var(--play-ink); font:500 14px/1.45 var(--sl-font-mono); }
  .run-timing span { color:var(--play-muted); font:13px/1.45 var(--sl-font); }
  @media (max-width:42rem) { .workbench-layout,.contract-grid { grid-template-columns:minmax(0,1fr); } .workbench-heading img { width:32px; height:32px; } }
  @media (prefers-reduced-motion:reduce) { .crud-playground *, .crud-playground *::before, .crud-playground *::after { scroll-behavior:auto !important; animation-duration:.01ms !important; transition-duration:.01ms !important; } }
</style>
