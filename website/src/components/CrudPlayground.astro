<section aria-labelledby="crud-playground-title" class="crud-playground">
  <p class="eyebrow">Browser-local contract explorer · no Python server</p>
  <h2 id="crud-playground-title">Try the typed CRUD contract</h2>
  <p>Choose fields, then explicitly run a request. Editing a draft never mutates the in-memory items.</p>
  <label>Operation <select id="operation"><option value="create">Create item</option><option value="update">Update item</option><option value="get">Get item</option><option value="delete">Delete item</option></select></label>
  <label>Item ID <input id="item-id" type="number" value="1"></label>
  <label>Name <input id="item-name" value="Notebook"></label>
  <label>Price <input id="item-price" type="number" step="any" value="12.5"></label>
  <button type="button" id="contract-run">Run request</button> <button type="button" id="contract-reset">Reset state</button>
  <p id="contract-error" role="alert"></p>
  <div class="contract-grid"><article><h3>Last request</h3><pre id="contract-request">No request run yet.</pre></article><article><h3>Response</h3><pre id="contract-response" aria-live="polite">No response yet.</pre></article></div>
  <p class="contract-note">Session-only state: starts with the example's starter item, at most 20 live items, monotonically increasing IDs. Reset to clear.</p>
</section>
<script>
  import { createState, execute } from '../scripts/crud-playground.js';
  const state = createState();
  const operation = document.querySelector<HTMLSelectElement>('#operation');
  const idField = document.querySelector<HTMLInputElement>('#item-id');
  const nameField = document.querySelector<HTMLInputElement>('#item-name');
  const priceField = document.querySelector<HTMLInputElement>('#item-price');
  const text = (selector: string, value: string) => { const node = document.querySelector<HTMLElement>(selector); if (node) node.textContent = value; };
  document.querySelector<HTMLButtonElement>('#contract-run')?.addEventListener('click', () => {
    if (!operation || !idField || !nameField || !priceField) return;
    const rawPrice = priceField.value;
    const result = execute(state, { operation: operation.value, id: Number(idField.value), name: nameField.value, price: rawPrice === '' ? Number.NaN : Number(rawPrice) });
    Object.assign(state, result.state);
    text('#contract-request', JSON.stringify(result.result.request, null, 2));
    text('#contract-response', JSON.stringify(result.result.response, null, 2));
    text('#contract-error', result.result.response.status >= 400 ? result.result.response.body.detail : '');
  });
  document.querySelector<HTMLButtonElement>('#contract-reset')?.addEventListener('click', () => {
    Object.assign(state, createState());
    if(operation) operation.value='create'; if(idField) idField.value='1'; if(nameField) nameField.value='Notebook'; if(priceField) priceField.value='12.5';
    text('#contract-request', 'No request run yet.'); text('#contract-response', 'No response yet.'); text('#contract-error', '');
  });
</script>
<style>
  .crud-playground { padding:1.2rem; border:1px solid var(--sl-color-gray-5); border-radius:1rem; } .eyebrow { color:var(--sl-color-accent-high); font-weight:650; }
  label { display:grid; gap:.35rem; max-width:26rem; margin-block:.65rem; } input,select,button { box-sizing:border-box; max-width:100%; padding:.55rem; }
  .contract-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr)); gap:.75rem; } article { min-width:0; padding:.75rem; border:1px solid var(--sl-color-gray-5); border-radius:.6rem; }
  pre { max-width:100%; overflow:auto; white-space:pre-wrap; overflow-wrap:anywhere; } #contract-error { color:var(--sl-color-red); } .contract-note { font-size:.9rem; }
</style>
