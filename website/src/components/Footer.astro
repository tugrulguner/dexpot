---
import DefaultFooter from "@astrojs/starlight/components/Footer.astro";

const issueTitle = "Dexpot website feedback";
const page = `https://dexpot.modepot.io${Astro.url.pathname}`;
const issueBody = `Page: ${page}`;
const issueUrl = new URL("https://github.com/tugrulguner/dexpot/issues/new");
issueUrl.searchParams.set("title", issueTitle);
issueUrl.searchParams.set("body", issueBody);
---
<DefaultFooter />
<footer class="public-feedback">
  <a href={issueUrl.href} target="_blank" rel="noopener noreferrer">
    Feedback / issue <span class="sr-only">(opens GitHub in a new tab)</span>
  </a>
  <span>Do not include private information in public issues.</span>
</footer>
<style>
  .public-feedback {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-text);
    font-size: 14px;
  }
  .public-feedback a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    border-radius: 6px;
    color: inherit;
    font-weight: 650;
  }
  .public-feedback a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
</style>
