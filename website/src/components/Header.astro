---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
---

<div class="header">
  <div class="title-wrapper sl-flex"><SiteTitle /></div>
  <div class="sl-flex print:hidden header-tools">
    <Search />
  </div>
  <div class="sl-flex print:hidden right-group">
    <nav class="family-links" aria-label="ModePot family">
      <a href="https://modepot.io/">ModePot</a>
      <a href="https://github.com/tugrulguner/dexpot">GitHub</a>
      <a href="https://discord.gg/u3AANZr6RG">Community</a>
      <a href="https://tugrul.modepot.io/">About Tugrul</a>
    </nav>
    <a class="family-home-mobile" href="https://modepot.io/">ModePot</a>
    <button class="family-menu-button" type="button" aria-expanded="false" aria-controls="family-mobile-menu">Menu</button>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>
<div id="family-mobile-menu" class="family-mobile-menu" role="region" aria-label="Menu" hidden>
  <nav class="family-mobile-resources" aria-label="ModePot family">
    <a href="https://github.com/tugrulguner/dexpot">GitHub</a>
    <a href="https://discord.gg/u3AANZr6RG">Community</a>
    <a href="https://tugrul.modepot.io/">About Tugrul</a>
  </nav>
  <nav class="family-mobile-docs" aria-label="Dexpot documentation">
    <a href="/">Overview</a>
    <a href="/quick-start/">Quick start</a>
    <a href="/build-guides/">Build guides</a>
    <a href="/route-contract/">Routes and handlers</a>
    <a href="/execution-model/">Execution model</a>
    <a href="/http-boundary/">HTTP boundary</a>
    <a href="/current-boundaries/">Current boundaries</a>
    <a href="/examples/">Runnable examples</a>
    <a href="/playground/">Request workbench</a>
    <a href="/agent-context/">Coding-agent context</a>
  </nav>
</div>

<script>
  const menuButton = document.querySelector('.family-menu-button');
  const menu = document.querySelector('#family-mobile-menu');
  if (menuButton instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    const closeMenu = (restoreFocus = false) => {
      menu.hidden = true;
      menuButton.setAttribute('aria-expanded', 'false');
      if (restoreFocus) menuButton.focus();
    };
    menuButton.addEventListener('click', () => {
      const opening = menu.hidden;
      menu.hidden = !opening;
      menuButton.setAttribute('aria-expanded', String(opening));
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMenu(true);
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) closeMenu(true);
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target) && !menuButton.contains(event.target)) closeMenu();
    });
  }
</script>

<style>
  @layer starlight.core {
    .header { display:flex; gap:var(--sl-nav-gap); justify-content:space-between; align-items:center; height:100%; }
    .title-wrapper { overflow:clip; padding:.25rem; margin:-.25rem; min-width:0; }
    .right-group,.family-links,.header-tools { display:flex; align-items:center; }
    .right-group { gap:1rem; }
    .family-links { gap:.25rem; }
    .family-links a,.family-home-mobile { color:var(--sl-color-white); font:400 16px/1.4 var(--mp-font); text-decoration:none; white-space:nowrap; }
    .family-links a { display:inline-flex; align-items:center; justify-content:center; min-width:44px; min-height:44px; padding-inline:8px; border-radius:6px; }
    .header-tools { gap:.5rem; min-width:0; }
    .family-home-mobile,.family-menu-button { display:none; }
    .family-mobile-menu { display:none; }
    .family-mobile-menu[hidden] { display:none; }
    @media (min-width:50rem) {
      :global(:root[data-has-sidebar]) { --__sidebar-pad:calc(2 * var(--sl-nav-pad-x)); }
      :global(:root:not([data-has-toc])) { --__toc-width:0rem; }
      .header { display:grid; grid-template-columns:minmax(0,1fr) auto auto; align-content:center; }
    }
    @media (max-width:49.999rem) {
      .header { gap:0; }
      .title-wrapper { flex:0 1 104px; }
      .header-tools { flex:0 0 auto; margin:0; justify-content:flex-end; gap:3px; }
      .right-group { display:flex !important; flex:0 0 auto; margin:0; justify-content:flex-end; gap:0; }
      .family-links, .right-group :global(starlight-lang-select) { display:none !important; }
      .family-home-mobile { display:inline-flex; align-items:center; justify-content:center; min-width:44px; min-height:44px; padding-inline:2px; font-size:13px; }
      :global(header.header starlight-theme-select) { flex:0 0 44px; width:44px; }
      :global(header.header starlight-theme-select label) { width:44px; --sl-select-width:2.75rem; --sl-inline-padding:0px; --sl-label-icon-size:0px; --sl-caret-size:0px; }
      :global(header.header starlight-theme-select .label-icon), :global(header.header starlight-theme-select .caret) { display:none; }
      :global(header.header starlight-theme-select select) { width:44px !important; margin-inline:0 !important; padding-inline:0 !important; text-align:center; }
      :global(header.header .header-tools site-search button) { min-width:44px; min-height:44px; }
      .family-menu-button { display:inline-flex; align-items:center; justify-content:center; min-width:48px; min-height:44px; padding:0 5px; border:1px solid var(--mp-control-light); border-radius:6px; background:var(--mp-raised-light); color:var(--mp-ink-light); font:600 13px/1.4 var(--mp-font); cursor:pointer; }
      :global(:root[data-theme='dark']) .family-menu-button { border-color:var(--mp-control-dark); background:var(--mp-raised-dark); color:var(--mp-ink-dark); }
      .family-mobile-menu:not([hidden]) { position:fixed; z-index:100; inset:64px 0 auto; display:block; max-height:calc(100dvh - 64px); overflow:auto; padding:12px 16px 24px; border-block:1px solid var(--sl-color-gray-5); background:var(--sl-color-bg-sidebar); box-shadow:0 8px 16px rgb(0 0 0 / .16); }
      .family-mobile-resources,.family-mobile-docs { display:grid; gap:4px; }
      .family-mobile-resources { padding-bottom:12px; border-bottom:1px solid var(--sl-color-gray-5); }
      .family-mobile-docs { padding-top:12px; }
      .family-mobile-menu a { display:flex; align-items:center; min-height:44px; padding:8px 12px; border-radius:6px; color:var(--sl-color-white); font:600 14px/1.4 var(--mp-font); text-decoration:none; }
      .family-mobile-menu a:hover { background:var(--sl-color-bg-nav); }
      :global(.sl-menu-button) { display:none !important; }
    }
  }
</style>
