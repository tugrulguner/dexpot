{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dexpot-site",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "dexpot.modepot.io",
      "custom_domain": true
    }
  ]
}
